[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 09/08/2026,0.3.2.0
CatalogFile = ReAIVibeBoardVirtualMic.cat
PnpLockDown = 1

[SourceDisksNames]
222="REAIVBMIC Driver Disk","",222

[SourceDisksFiles]
ReAIVibeBoardVirtualMic.sys=222

[Manufacturer]
%MfgName%=REAIVBMIC,NT$ARCH$.10.0...19041

[REAIVBMIC.NT$ARCH$.10.0...19041]
%REAIVBMIC_SA.DeviceDesc%=REAIVBMIC_SA, ROOT\ReAIVB

[DestinationDirs]
REAIVBMIC_SA.CopyList=13 ; 13=Package's DriverStore directory

;======================================================
; REAIVBMIC_SA
;======================================================
[REAIVBMIC_SA.CopyList]
ReAIVibeBoardVirtualMic.sys

[REAIVBMIC_SA.AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,ReAIVibeBoardVirtualMic.sys

;
; For demo only, please review these power management settings for your architecture.
;
HKR,PowerSettings,ConservationIdleTime,3,3,0,0,0          ; 3 seconds for idle power management when on battery
HKR,PowerSettings,PerformanceIdleTime,3,3,0,0,0           ; 3 seconds for idle power management when on AC power
HKR,PowerSettings,IdlePowerState,3,3,0,0,0                ; go to D3 for idle power management

HKR,Drivers,SubClasses,,"wave,mixer"

HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%REAIVBMIC_SA.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%REAIVBMIC_SA.DeviceDesc%

;======================================================
; capture interface: the "ReAI-Vibe-Board" microphone
;======================================================
[REAIVBMIC.I.WaveMicArray1]
AddReg=REAIVBMIC.I.WaveMicArray1.AddReg
[REAIVBMIC.I.WaveMicArray1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%REAIVBMIC.WaveMicArray1.szPname%

[REAIVBMIC.I.TopologyMicArray1]
AddReg=REAIVBMIC.I.TopologyMicArray1.AddReg

[REAIVBMIC.I.TopologyMicArray1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%REAIVBMIC.TopologyMicArray1.szPname%

HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

; Override the endpoint friendly name so apps and sound settings see exactly
; "ReAI-Vibe-Board" (the SDK's virtual_mic::DEVICE_NAME) instead of the
; default "<category> (<device description>)" composition.
HKR,EP\0,%PKEY_Device_FriendlyName%,,%REAIVBMIC.Endpoint.szName%

; The following lines opt-in to pull mode.
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;======================================================
; REAIVBMIC_SA
;======================================================
[REAIVBMIC_SA.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=REAIVBMIC_SA.CopyList
AddReg=REAIVBMIC_SA.AddReg

[REAIVBMIC_SA.NT.Interfaces]
;
; Interfaces for the capture endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_WaveMicArray1%, REAIVBMIC.I.WaveMicArray1
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveMicArray1%, REAIVBMIC.I.WaveMicArray1
AddInterface=%KSCATEGORY_CAPTURE%,  %KSNAME_WaveMicArray1%, REAIVBMIC.I.WaveMicArray1
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_TopologyMicArray1%, REAIVBMIC.I.TopologyMicArray1
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMicArray1%, REAIVBMIC.I.TopologyMicArray1

[REAIVBMIC_SA.NT.Services]
AddService=ReAIVibeBoardVirtualMic,0x00000002,REAIVBMIC_Service_Inst

[REAIVBMIC_Service_Inst]
DisplayName=%REAIVBMIC.SvcDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\ReAIVibeBoardVirtualMic.sys

[REAIVBMIC_SA.NT.HW]
AddReg = REAIVBMIC_AUDIOHW.AddReg

[REAIVBMIC_AUDIOHW.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; SDDL_DEVOBJ_SYS_ALL_ADM_RWX_WORLD_RWX_RES_RWX
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"


;======================================================
; WDF
;======================================================
[REAIVBMIC_SA.NT.Wdf]
KmdfService = ReAIVibeBoardVirtualMic, REAIVBMIC_WdfSect
[REAIVBMIC_WdfSect]
KmdfLibraryVersion = $KMDFVERSION$

;======================================================
; COMMON
;======================================================
[Strings]

;Non-localizable

KSNAME_WaveMicArray1="WaveMicArray1"
KSNAME_TopologyMicArray1="TopologyMicArray1"

Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME ="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"

KSNODETYPE_ANY   = "{00000000-0000-0000-0000-000000000000}"

PKEY_AudioEndpoint_Association               = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
PKEY_Device_FriendlyName                     = "{a45c254e-df1c-4efd-8020-67d146a850e0},14"

;Localizable

ProviderName = "ReAI"
MfgName      = "ReAI"

REAIVBMIC_SA.DeviceDesc="ReAI-Vibe-Board"
REAIVBMIC.SvcDesc="ReAI-Vibe-Board Virtual Microphone Driver"

;; friendly names (what apps see in sound settings / device pickers)
REAIVBMIC.WaveMicArray1.szPname="ReAI-Vibe-Board"
REAIVBMIC.TopologyMicArray1.szPname="ReAI-Vibe-Board"
REAIVBMIC.Endpoint.szName="ReAI-Vibe-Board"

MicArray1CustomName= "ReAI-Vibe-Board"
